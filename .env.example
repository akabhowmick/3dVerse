# PayPal REST app client ID (Live or Sandbox) used by @paypal/react-paypal-js
# to render the buttons in the browser. Safe to expose client-side.
VITE_PAYPAL_CLIENT_ID=

# --- Netlify Functions only (server-side, never exposed to the browser) ---

# PayPal REST app client ID and secret used by netlify/functions to create
# and capture orders server-side. PAYPAL_SECRET must never be prefixed with
# VITE_ or referenced anywhere under src/.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# "sandbox" or "live" -- selects the PayPal API base URL the functions call.
PAYPAL_ENV=sandbox
